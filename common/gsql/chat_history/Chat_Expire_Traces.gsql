// Delete traces older than cutoff_epoch, with their steps.
//
// Replaces the 30-day file sweep that ran on every trace write. Traces hold
// the user's prompts and retrieved document text, so retention is a privacy
// control, not housekeeping -- the messages they hang off are kept.
//
// Not scoped to a user: expiry is a maintenance operation over all traces.
// Like the rest of this set it is installed but never registered in the
// embedding store, so the agent cannot invoke it.

CREATE OR REPLACE DISTRIBUTED QUERY Chat_Expire_Traces(UINT cutoff_epoch) {
  SumAccum<INT> @@deleted;

  AllTraces = {ChatTrace.*};

  Stale = SELECT t
          FROM AllTraces:t
          WHERE t.create_epoch > 0 AND t.create_epoch < cutoff_epoch
          ACCUM @@deleted += 1;

  Steps = SELECT st FROM Stale:t -(HAS_STEP>)- ChatTraceStep:st;

  DELETE st FROM Steps:st;
  DELETE t  FROM Stale:t;

  PRINT @@deleted AS deleted;
}
