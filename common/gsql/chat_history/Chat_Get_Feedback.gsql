// Messages carrying feedback in u's own conversations.
//
// The non-admin half of the feedback view. Admins use Chat_Get_All_Feedback,
// which is a separate query rather than a role flag on this one -- a flag
// would put "return everyone's data" one wrong argument away.

CREATE OR REPLACE DISTRIBUTED QUERY Chat_Get_Feedback(VERTEX<ChatUser> u) {
  Start = {u};

  Convs = SELECT c
          FROM Start:s -(OWNS_CONVERSATION>)- ChatConversation:c
          WHERE c.deleted_epoch == 0;

  Msgs = SELECT m
         FROM Convs:c -(HAS_MESSAGE>)- ChatMessage:m
         WHERE m.feedback != 0;

  PRINT Msgs;
}
