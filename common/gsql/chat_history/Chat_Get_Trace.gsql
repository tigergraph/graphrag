// Execution trace for one of u's messages, with its steps in order and the
// corpus vertices each step retrieved.
//
// Reached forward from u rather than seeded at the message: a message_id the
// caller does not own is simply not in Msgs. Seeding at ChatMessage and
// walking back to ChatUser would be cheaper but requires reverse traversal
// out of a vertex the caller may not own -- the exact pattern this design
// avoids.
//
// Fan-out is bounded by one user's own history (~50 conversations x ~20
// messages at the assumed scale), so the forward walk is preferred over the
// cheaper unsafe shape.

CREATE OR REPLACE DISTRIBUTED QUERY Chat_Get_Trace(VERTEX<ChatUser> u, STRING message_id) {
  Start = {u};

  Convs = SELECT c
          FROM Start:s -(OWNS_CONVERSATION>)- ChatConversation:c
          WHERE c.deleted_epoch == 0;

  Msgs = SELECT m
         FROM Convs:c -(HAS_MESSAGE>)- ChatMessage:m
         WHERE m.message_id == message_id;

  Traces = SELECT t
           FROM Msgs:m -(HAS_TRACE>)- ChatTrace:t;

  Steps = SELECT st
          FROM Traces:t -(HAS_STEP>)- ChatTraceStep:st
          ORDER BY st.idx ASC;

  // Provenance hangs off the trace when the engine reports retrieval per
  // answer (the current case) and off a step when it reports per node, so
  // both sources are unioned rather than assuming one shape.
  FromTrace = SELECT r FROM Traces:t -(RETRIEVED>)- :r;
  FromSteps = SELECT r FROM Steps:st -(RETRIEVED>)- :r;
  Retrieved = FromTrace UNION FromSteps;

  PRINT Traces;
  PRINT Steps;
  PRINT Retrieved;
}
