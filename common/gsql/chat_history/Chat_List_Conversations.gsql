// Conversations owned by u, most recently updated first.
//
// u is a VERTEX<ChatUser> rather than a STRING so the caller cannot express
// "every conversation" -- the query has no reachable start set other than one
// user. Callers must pass the authenticated principal; see
// ConversationRepository, which is the only code permitted to run this.
//
// Also returns each conversation's first message, keyed by conversation_id.
// `name` is usually empty -- nothing sets a title on the agent's write path
// -- so the caller needs something human-readable to show instead of a raw
// UUID. The first turn (seq == 1) is the cheapest stand-in for a title: one
// extra bounded hop off Convs, not a second query per conversation.

CREATE OR REPLACE DISTRIBUTED QUERY Chat_List_Conversations(VERTEX<ChatUser> u) {
  MapAccum<STRING, STRING> @@first_message;

  Start = {u};

  Convs = SELECT c
          FROM Start:s -(OWNS_CONVERSATION>)- ChatConversation:c
          WHERE c.deleted_epoch == 0
          ORDER BY c.update_epoch DESC;

  FirstMsgs = SELECT m
              FROM Convs:c -(HAS_MESSAGE>)- ChatMessage:m
              WHERE m.seq == 1
              ACCUM @@first_message += (c.conversation_id -> m.content);

  PRINT Convs;
  PRINT @@first_message AS first_message;
}
