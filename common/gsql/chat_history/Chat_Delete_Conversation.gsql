// Hard-delete one of u's conversations and everything hanging off it.
//
// Hard rather than soft because this is the erasure path: a soft delete
// leaves message content and trace payloads (which carry the user's prompts
// and retrieved document text) resident indefinitely. Chat_List_Conversations
// filters on deleted_epoch for the UI's own soft-hide; this query is the one
// that actually removes data.
//
// Deletes bottom-up so no edge outlives its endpoints. RETRIEVED edges are
// removed implicitly with their ChatTraceStep -- the DocumentChunk / Entity /
// Community they point at are shared corpus and are never touched.

CREATE OR REPLACE DISTRIBUTED QUERY Chat_Delete_Conversation(VERTEX<ChatUser> u, STRING conversation_id) {
  Start = {u};

  Convs = SELECT c
          FROM Start:s -(OWNS_CONVERSATION>)- ChatConversation:c
          WHERE c.conversation_id == conversation_id;

  Msgs = SELECT m
         FROM Convs:c -(HAS_MESSAGE>)- ChatMessage:m;

  Traces = SELECT t
           FROM Msgs:m -(HAS_TRACE>)- ChatTrace:t;

  Steps = SELECT st
          FROM Traces:t -(HAS_STEP>)- ChatTraceStep:st;

  DELETE st FROM Steps:st;
  DELETE t  FROM Traces:t;
  DELETE m  FROM Msgs:m;
  DELETE c  FROM Convs:c;

  PRINT Convs.size() AS deleted;
}
