/*
 * This is the only cross-user read query. The Python admin repository checks
 * the authenticated caller's role before invoking it.
 */
CREATE OR REPLACE DISTRIBUTED QUERY Chat_Get_All_Feedback_Admin(
    UINT cursor_updated_at,
    STRING cursor_id,
    INT page_size
) FOR GRAPH GraphRAGChatHistory SYNTAX v2 {
    users = {ChatUser.*};
    rows = SELECT m
        FROM users:u -(OWNS_CONVERSATION>:e1)- ChatConversation:c
             -(HAS_MESSAGE>:e2)- ChatMessage:m
        WHERE c.status != "deleted"
          AND (
              cursor_updated_at == 0
              OR m.updated_at < cursor_updated_at
              OR (
                  m.updated_at == cursor_updated_at
                  AND m.message_id < cursor_id
              )
          )
        ORDER BY m.updated_at DESC, m.message_id DESC
        LIMIT page_size;
    PRINT rows AS rows;
}
