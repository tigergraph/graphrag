CREATE SCHEMA_CHANGE JOB add_document_versions {
    ALTER VERTEX Document ADD ATTRIBUTE (content_checksum STRING, outdated BOOL);
    ADD DIRECTED EDGE SUPERSEDED_BY(FROM Document, TO Document, epoch_added UINT) WITH REVERSE_EDGE="reverse_SUPERSEDED_BY";
}
