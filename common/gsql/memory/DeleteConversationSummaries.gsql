 *
 * Delete summary vertices for one conversation (conv_pk = conversation PRIMARY_ID).
 * V2: one SELECT from seeds with directed hop -(has_summary>)- ; POST-ACCUM DELETE (s).
 */

CREATE OR REPLACE DISTRIBUTED QUERY delete_conversation_summaries(STRING conv_pk) SYNTAX V2 {
  seeds = {conversation.*};
  del = SELECT s
        FROM seeds:c -(has_summary>)- summary:s
        WHERE c.conversation_id == conv_pk
        POST-ACCUM DELETE (s);
}
