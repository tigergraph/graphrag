 *
 * Returns the conversation vertex for memory summary fields (conv_pk = vertex PRIMARY_ID).
 */

CREATE OR REPLACE DISTRIBUTED QUERY get_conversation_summary(STRING conv_pk) SYNTAX V2 {
  seeds = {conversation.*};
  res = SELECT c FROM seeds:c WHERE c.conversation_id == conv_pk;
  PRINT res AS rows;
}
